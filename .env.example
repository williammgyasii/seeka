# Copy to .env. Never commit the populated file.
# Use a direct (non-pooled) Neon endpoint for the current single API instance.
ConnectionStrings__Seeka=Host=your-neon-host;Port=5432;Database=seeka;Username=seeka_owner;Password=replace_me;SSL Mode=Require
NEON_PROJECT_ID=replace_me

API_PORT=5099
WEB_PORT=5173

# No provider credentials are required by the first working slice.
# Future AI, ATS, enrichment, email, and billing keys must stay server-side.
