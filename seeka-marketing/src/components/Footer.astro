---
import Brand from './Brand.astro'
import { REGISTER_URL, SIGN_IN_URL } from '../lib/site'

const year = new Date().getFullYear()
---

<footer class="border-t border-border bg-muted">
  <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 sm:grid-cols-[2fr_1fr_1fr]">
    <div class="grid content-start gap-3">
      <Brand />
      <p class="max-w-xs text-sm text-muted-foreground">
        Find out which jobs fit, then reach a real person inside the company.
      </p>
    </div>
    <div class="grid content-start gap-2 text-sm">
      <p class="font-semibold">Guides</p>
      <a href="/guides/how-to-get-a-referral/" class="text-muted-foreground hover:text-foreground"
        >Get a referral</a
      >
      <a href="/guides/find-the-hiring-manager/" class="text-muted-foreground hover:text-foreground"
        >Find the hiring manager</a
      >
      <a href="/guides/message-a-recruiter/" class="text-muted-foreground hover:text-foreground"
        >Message a recruiter</a
      >
      <a
        href="/guides/no-response-to-applications/"
        class="text-muted-foreground hover:text-foreground">No response to applications</a
      >
    </div>
    <div class="grid content-start gap-2 text-sm">
      <p class="font-semibold">Seeka</p>
      <a href={REGISTER_URL} class="text-muted-foreground hover:text-foreground">Create an account</a>
      <a href={SIGN_IN_URL} class="text-muted-foreground hover:text-foreground">Sign in</a>
    </div>
  </div>
  <p class="mx-auto max-w-6xl px-5 pb-8 text-xs text-muted-foreground">© {year} Seeka</p>
</footer>
