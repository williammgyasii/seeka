---
import { REGISTER_URL } from '../lib/site'

type Props = { title: string; body: string }
const { title, body } = Astro.props
---

<aside class="rounded-2xl bg-ink px-6 py-10 text-white sm:px-10">
  <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h2>
  <p class="mt-3 max-w-xl text-white/80">{body}</p>
  <a
    href={REGISTER_URL}
    class="mt-6 inline-block rounded-lg bg-highlight px-5 py-3 font-semibold text-highlight-foreground transition-transform hover:-translate-y-0.5 motion-reduce:transition-none"
    >Get started free</a
  >
</aside>
