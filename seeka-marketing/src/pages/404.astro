---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Page not found"
  description="This page does not exist. Head back to Seeka's home page or read the job search guides."
  path="/404/"
  noindex
>
  <section class="mx-auto max-w-2xl px-5 py-24 text-center">
    <p class="text-sm font-medium tracking-wide text-muted-foreground uppercase">404</p>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight">This page doesn't exist</h1>
    <p class="mt-4 text-lg text-muted-foreground">
      The link may be old or mistyped. Here's where to go instead.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-lg bg-ink px-5 py-3 font-semibold text-white hover:bg-ink-deep"
        >Go home</a
      >
      <a href="/guides/" class="rounded-lg px-5 py-3 font-semibold ring-1 ring-border hover:bg-muted"
        >Read the guides</a
      >
    </div>
  </section>
</BaseLayout>
