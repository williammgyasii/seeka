---
import { render } from 'astro:content'
import CallToAction from '../../components/CallToAction.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { guides } from '../../lib/guides'
import { ORIGIN, organization } from '../../lib/site'

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.entry.id }, props: { guide } }))
}

const { guide } = Astro.props
const { Content } = await render(guide.entry)
const { title, description, published } = guide.entry.data
const date = published.toISOString().slice(0, 10)
const others = guides.filter((other) => other.path !== guide.path)

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    datePublished: date,
    dateModified: date,
    mainEntityOfPage: `${ORIGIN}${guide.path}`,
    author: { '@type': 'Organization', name: 'Seeka', url: ORIGIN },
    publisher: organization,
    image: `${ORIGIN}/og.png`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Guides', item: `${ORIGIN}/guides/` },
      { '@type': 'ListItem', position: 2, name: title, item: `${ORIGIN}${guide.path}` },
    ],
  },
]
---

<BaseLayout
  title={title}
  description={description}
  path={guide.path}
  structuredData={structuredData}
  ogType="article"
>
  <article class="mx-auto max-w-3xl px-5 py-16 sm:py-20">
    <nav aria-label="Breadcrumb" class="text-sm text-muted-foreground">
      <a href="/guides/" class="hover:text-foreground">Guides</a>
    </nav>
    <h1 class="mt-3 text-4xl leading-tight font-semibold tracking-tight sm:text-5xl">{title}</h1>
    <p class="mt-4 text-sm text-muted-foreground">
      Published <time datetime={date}>{published.toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })}</time>
    </p>
    <div class="prose-guide mt-10">
      <Content />
    </div>
    <div class="mt-14">
      <CallToAction
        title="Stop applying cold"
        body="Seeka tells you which jobs fit, then helps you write to the person who can say yes."
      />
    </div>
    <section class="mt-14" aria-labelledby="more-guides">
      <h2 id="more-guides" class="text-xl font-semibold">More guides</h2>
      <ul class="mt-4 grid gap-3">
        {
          others.map((other) => (
            <li>
              <a href={other.path} class="font-medium text-ink underline underline-offset-4">
                {other.title}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>
