{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seeka-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "upload_source_maps": true,
  "containers": [
    {
      "class_name": "SeekaApiContainer",
      "image": "../seeka-backend/Dockerfile",
      "image_build_context": "..",
      "max_instances": 1,
      "instance_type": "lite",
      "constraints": {
        "regions": ["ENAM"]
      },
      "observability": {
        "logs": {
          "enabled": true
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API_CONTAINER",
        "class_name": "SeekaApiContainer"
      }
    ]
  },
  "exports": {
    "SeekaApiContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
